{
    "name": "overay-backend",
    "version": "1.0.0",
    "description": "",
    "main": "src/index.js",
    "scripts": {
        "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --detectOpenHandles --forceExit",
        "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
        "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
        "start": "node src/index.js",
        "dev": "nodemon --env-file=.env.local .",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@apollo/server": "^4.10.4",
        "@sendgrid/mail": "^8.1.3",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "express": "^4.19.2",
        "file-stream-rotator": "^1.0.0",
        "firebase-admin": "^12.3.1",
        "fs-extra": "^11.2.0",
        "google-auth-library": "^9.14.1",
        "graphql": "^16.8.1",
        "joi": "^17.13.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.1",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^3.0.3",
        "pino": "^9.2.0",
        "pino-pretty": "^11.2.1",
        "razorpay": "^2.9.4",
        "twilio": "^5.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@jest/globals": "^29.7.0",
        "dotenv": "^16.4.5",
        "eslint": "^9.15.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "supertest": "^6.3.3"
    },
    "type": "module",
    "jest": {
        "testEnvironment": "node",
        "globals": {
            "NODE_OPTIONS": "--experimental-vm-modules"
        },
        "transform": {},
        "collectCoverageFrom": [
            "src/**/*.js",
            "!src/index.js",
            "!src/uploads/**",
            "!src/email-templates/**"
        ],
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ],
        "testMatch": [
            "**/__tests__/**/*.js",
            "**/?(*.)+(spec|test).js"
        ]
    }
}
